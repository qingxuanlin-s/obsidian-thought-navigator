{
	"name": "thought-navigator",
	"version": "0.2.5",
	"description": "A visual knowledge-processing workspace: connect notes, shape MOCs, build mind maps, and turn Zettelkasten-style thinking into navigable thought maps.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint \"**/*.ts\"",
		"lint:fix": "eslint \"**/*.ts\" --fix",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"mindmap",
		"zettelkasten",
		"moc",
		"knowledge-management"
	],
	"author": "",
	"license": "PolyForm-Noncommercial-1.0.0",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/cytoscape": "^3.19.16",
		"@types/d3": "^7.4.3",
		"@types/node": "^16.11.6",
		"esbuild": "0.14.47",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.62.0"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"cytoscape": "^3.28.1",
		"cytoscape-cose-bilkent": "^4.1.0",
		"cytoscape-dagre": "^2.5.0",
		"cytoscape-elk": "^2.3.0",
		"d3": "^7.9.0",
		"dagre": "^0.8.5",
		"elkjs": "^0.11.0",
		"html-to-image": "^1.11.13",
		"svg-pan-zoom": "^3.6.1"
	}
}
